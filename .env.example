# Copy to .env before running docker compose.
# Running locally? The defaults below already work - you can skip this file.

# Database
POSTGRES_DB=order_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Sign tokens with your own value
JWT_SECRET=replace-with-a-long-random-string

# Both addresses are how a browser reaches the app, so on a server they
# use the public host rather than localhost:
#   NEXT_PUBLIC_API_URL=http://203.0.113.10:3000
#   CORS_ORIGIN=http://203.0.113.10:3001
NEXT_PUBLIC_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
