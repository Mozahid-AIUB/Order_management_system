{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Without this the compiler also picks up prisma/, which pushes the
    // output down to dist/src/main.js instead of dist/main.js.
    "rootDir": "./src",
    // Keep the incremental cache inside dist. nest-cli deletes dist before
    // every build, so leaving the cache outside makes tsc believe the output
    // is still current and emit nothing at all.
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "dist-seed", "**/*spec.ts"]
}
