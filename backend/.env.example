# Copy to .env and fill in your own values.
#   cp .env.example .env

# Your local PostgreSQL. URL-encode special characters in the password:
# "@" becomes "%40", "#" becomes "%23".
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/order_management?schema=public"

# Signs the JWTs. Any long random string will do locally.
JWT_SECRET="replace-with-a-long-random-string"

# Optional. Outside production the API accepts whichever origin asks, so this
# only matters when NODE_ENV=production. Comma-separated for several origins.
# CORS_ORIGIN=http://localhost:3001

# Optional. Defaults to 3000.
# PORT=3000
